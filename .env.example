# Local development only. Keep assignments compatible with both POSIX sh and Compose.
# Copy to .env (make setup does this without overwriting an existing file).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=housesync
DB_USER=housesync
DB_PASSWORD=housesync_local_only
SERVER_PORT=8080
# Native development only; Compose does not forward this listener setting.
SERVER_ADDRESS=127.0.0.1
# Local HTTP only; the backend defaults to Secure cookies outside Make/Compose development.
SESSION_COOKIE_SECURE=false
