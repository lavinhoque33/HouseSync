# Local development only. Keep assignments compatible with both POSIX sh and Compose.
# Copy to .env (make setup does this without overwriting an existing file).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=housesync
DB_USER=housesync
DB_PASSWORD=housesync_local_only
SERVER_PORT=8080
# Native development only; Compose does not forward this listener setting.
SERVER_ADDRESS=127.0.0.1
# Local HTTP only; the backend defaults to Secure cookies outside Make/Compose development.
SESSION_COOKIE_SECURE=false

# Connected finance is opt-in. Keep disabled unless configuring Plaid or an explicit local fake.
CONNECTED_FINANCE_ENABLED=false
CONNECTED_FINANCE_PROVIDER=plaid
CONNECTED_FINANCE_FAKE_ALLOWED=false
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_REDIRECT_URL=
PLAID_WEBHOOK_URL=
# Comma-separated keyId:base64(32-byte-key) entries; first key encrypts new values.
CONNECTED_FINANCE_KEYS=
