# Reference hosted configuration; reviewed operator deployment only.
#
# Copy to an untracked repository-root `.env` on a separately configured host.
#
#   cp deploy/hosted.env.example .env
#
# This file is NOT used by local development: `make setup` copies the root `.env.example`
# (loopback ports, `SESSION_COOKIE_SECURE=false`, local password) instead, and Compose loads only the
# repository-root `.env`. The two files must not be swapped.
#
# Values must stay compatible with both POSIX sh and Docker Compose parsing.

# Replace with the operator-controlled public hostname (DNS and TCP 80/443 required).
# `DOMAIN` is mandatory; `.test` is deliberately non-deployable.
DOMAIN=app.example.test

# Password for the hosted PostgreSQL container, generated once with:
#   openssl rand -base64 32
# Changing it later does not re-key an existing database volume; see deploy/README.md.
DB_PASSWORD=replace-with-a-generated-database-password

# The hosted deployment is HTTPS-only, so session cookies must be Secure. Do not set this to false on the host.
SESSION_COOKIE_SECURE=true

# Hosted baseline: connected finance (Plaid) and optional AI categorization stay off.
# Enabling either requires its own provider credentials and security review.
CONNECTED_FINANCE_ENABLED=false
CONNECTED_FINANCE_FAKE_ALLOWED=false
CATEGORIZATION_AI_ENABLED=false
